# Copy to .env (git-ignored) for local development and Docker Compose.
# Everything here is non-secret configuration; real secrets never belong in the repository.

# --- API runtime ---------------------------------------------------------------------------

PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Directory with the processed datasets (output of `npm run data:build`) and the built SPA.
# Defaults are ./data and ./web relative to the API's working directory; Docker Compose sets
# them to the right container paths, so leave these commented unless you run outside Docker.
# DATA_DIR=/absolute/path/to/votobr/data/processed
# WEB_DIR=/absolute/path/to/votobr/apps/web/dist

# Comma-separated browser origins allowed to call the API cross-origin (dev server -> API).
CORS_ORIGINS=http://localhost:5173

# Leave empty locally. In production Terraform generates it and CloudFront sends it as the
# x-origin-verify header; when set, the API rejects requests without it (except GET /healthz).
ORIGIN_VERIFY_SECRET=

# --- Web build (public values: they end up in the browser bundle) ---------------------------

# Website ID from your Umami dashboard (https://cloud.umami.is or self-hosted); empty disables analytics.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
VITE_SITE_URL=http://localhost:5173
