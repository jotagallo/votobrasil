# Variáveis públicas do frontend (embutidas no bundle em tempo de build).
# Nenhuma delas é segredo: nunca coloque tokens ou chaves privadas aqui.

# ID público do site no Umami (Cloud ou próprio). Vazio = sem análise de audiência e sem script externo.
VITE_UMAMI_WEBSITE_ID=

# URL do script do Umami. Padrão: https://cloud.umami.is/script.js
# Com Umami próprio, use a URL do seu servidor e libere essa origem no CSP (script-src e connect-src).
VITE_UMAMI_SRC=

# Origem pública do site, sem barra final (canonical, hreflang e Open Graph). Ex.: https://votobr.example
# Vazio = usa a origem da página aberta.
VITE_SITE_URL=

# URL do repositório de código aberto (rodapé, Sobre e Metodologia). Vazio = o link não é exibido.
VITE_REPO_URL=

# Somente desenvolvimento (`npm run dev`): 1 = sempre usa o mock da API; 0 = nunca usa o mock
# (proxy para API_PROXY_TARGET); vazio = usa a API real se /healthz responder, senão o mock.
VITE_MOCK_API=

# Somente desenvolvimento: destino do proxy de /api e /healthz. Padrão: http://localhost:8080
# (lida pelo vite.config.ts; não tem prefixo VITE_ e não vai para o bundle).
API_PROXY_TARGET=
