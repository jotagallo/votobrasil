# Copy to terraform.tfvars (git-ignored) or pass with -var-file. Never commit real values.

aws_region = "sa-east-1" # Sao Paulo, next to the audience; "us-east-1" is cheaper but farther
project    = "votobr"
environment = "prod"

instance_type = "t4g.small"

github_repository = "owner/repo"

# Optional custom domain (see docs/DEPLOY.md, Etapa 10, before applying)
# domain_name = "votobr.example.org"
# Host the domain's DNS in Route 53 (registrar keeps the registration, delegates the name servers):
# manage_dns = true
# Also serve www.<domain_name> as a 301 to the bare domain:
# redirect_www = true
# Set the ARN only to reuse an existing issued certificate in us-east-1:
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Set to false when the AWS account already has the GitHub Actions OIDC provider
# create_github_oidc_provider = true

# cloudfront_price_class = "PriceClass_All"

# Enables the monthly budget alert and the environment health alarm
# alarm_email        = "you@example.org"
# monthly_budget_usd = 40
