// CloudFront Function (cloudfront-js-2.0), rendered by Terraform's templatefile().
// Answers www.<domain> with a 301 to the bare domain; every other host passes through unchanged.
var WWW_HOST = ${jsonencode(www_domain)};
var CANONICAL_ORIGIN = ${jsonencode("https://${domain}")};

function handler(event) {
  var request = event.request;
  var host = request.headers.host ? request.headers.host.value.toLowerCase() : '';
  if (host !== WWW_HOST) {
    return request;
  }

  var query = [];
  for (var name in request.querystring) {
    var param = request.querystring[name];
    var values = param.multiValue ? param.multiValue : [param];
    for (var i = 0; i < values.length; i++) {
      query.push(values[i].value === '' ? name : name + '=' + values[i].value);
    }
  }

  return {
    statusCode: 301,
    statusDescription: 'Moved Permanently',
    headers: {
      location: { value: CANONICAL_ORIGIN + request.uri + (query.length ? '?' + query.join('&') : '') },
    },
  };
}
